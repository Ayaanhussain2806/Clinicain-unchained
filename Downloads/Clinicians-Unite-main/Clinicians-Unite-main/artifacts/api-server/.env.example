# Razorpay Configuration
# Get these from: https://dashboard.razorpay.com/app/keys

# Test Mode Credentials (for development)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx_secret_for_test

# Production Credentials (change before deploying to production)
# RAZORPAY_KEY_ID=rzp_live_xxxxx
# RAZORPAY_KEY_SECRET=xxxxx_secret_for_production

# Optional: Webhook Secret (if implementing webhooks)
# RAZORPAY_WEBHOOK_SECRET=webhook_secret_from_dashboard
