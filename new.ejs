<% layout('layouts/boilerplate') %>
<%- include('../partials/navbar') %>

<div class="row my-5">
  <div class="col-md-6 mx-auto">
    <div class="card shadow p-4">
      <h3 class="mb-4 text-center">Add New Product</h3>
      
     
      <form action="/products" method="POST" autocomplete="off">
        
        <div class="mb-3">
          <label for="naam" class="form-label">Name</label>
          <input 
            type="text" 
            class="form-control" 
            name="productName" 
            id="naam" 
            placeholder="Enter product name" 
            autocomplete="off">
        </div>

        <div class="mb-3">
          <label for="img" class="form-label">Image</label>
          <input 
            type="text" 
            class="form-control" 
            name="productImg" 
            id="img" 
            placeholder="Enter image URL" 
            autocomplete="off">
        </div>

        <div class="mb-3">
          <label for="paisa" class="form-label">Price</label>
          <input 
            type="number" 
            class="form-control" 
            name="productPrice" 
            id="paisa" 
            placeholder="Enter product price" 
            min="0" 
            autocomplete="off">
        </div>

        <div class="mb-3">
          <label for="desc" class="form-label">Description</label>
          <textarea 
            name="productDesc" 
            id="desc" 
            class="form-control" 
            rows="4" 
            placeholder="Enter product description" 
            autocomplete="off"></textarea>
        </div>

        <div class="text-center">
          <button class="btn btn-success px-4" type="submit">Add Product</button>
        </div>
      </form>
    </div>
  </div>
</div>
