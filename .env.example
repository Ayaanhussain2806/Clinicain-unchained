# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=Clinician-Unchained

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinician_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=clinician_db
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRATION=24h

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@clinician-unchained.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# OTP Configuration
OTP_EXPIRATION=300
OTP_LENGTH=6

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# Practo Integration
PRACTO_API_KEY=your_practo_api_key
PRACTO_API_SECRET=your_practo_api_secret

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=clinician-unchained
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# API Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW=60000

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Python ML Service
FLASK_ENV=development
FLASK_DEBUG=1
ML_API_URL=http://localhost:5001

# Sentry (Error Tracking)
SENTRY_DSN=

# Feature Flags
ENABLE_TELEMEDICINE=false
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true

# Security
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
SESSION_SECRET=your_session_secret
CSRF_TOKEN_SECRET=your_csrf_secret
